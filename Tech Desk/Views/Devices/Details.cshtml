@model Tech_Desk.Models.Device

@{
    ViewData["Title"] = "Device Details";
}

<h1>@Model.Name</h1>

<div>
    <h4>Device Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Asset tag</dt>
        <dd class="col-sm-9">@Model.AssetTag</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category</dd>

        <dt class="col-sm-3">Year bought</dt>
        <dd class="col-sm-9">@Model.PurchaseYear</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(Model.IsOnLoan ? "On loan" : "Available")</dd>
    </dl>
</div>
<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>