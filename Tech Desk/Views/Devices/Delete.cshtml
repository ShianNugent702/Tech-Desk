@model Tech_Desk.Models.Device

@{
    ViewData["Title"] = "Delete Device";
}

<h1>Delete device</h1>

<h3 class="text-danger">Are you sure you want to delete this?</h3>
<div>
    <h4>Delete @Model.AssetTag @Model.Name?</h4>
    <hr />
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Yes, delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">No, go back</a>
    </form>
</div>
